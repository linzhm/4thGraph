-def require_affine_msm(field, constant, terms, claimed_x, claimed_y, *, checked_offset=None):
+def _point_for_window(field, host, base, digit, width):
+    """Select a fixed-base multiple by bounded digit. Zero selects base as a dummy."""
+    multiples = [base, base]
+    for _ in range(2, 1 << width):
+        multiples.append(host.add_host(multiples[-1], base))
+    while len(multiples) > 1:
+        quotient = field.divide(digit, 2) if len(multiples) > 2 else 0
+        bit = field.sub(digit, field.mul(quotient, 2))
+        multiples = [_choose(field, bit, odd, even)
+                     for even, odd in zip(multiples[::2], multiples[1::2], strict=True)]
+        digit = quotient
+    return multiples[0]
+
+
+def _add_windowed_term(field, curve, jacobian, host, accumulator, scalar, base, width, window_bits):
+    for offset in range(0, width, window_bits):
+        take = min(window_bits, width - offset)
+        continued = offset + take < width
+        quotient = field.divide(scalar, 1 << take) if continued else 0
+        digit = field.sub(scalar, field.mul(quotient, 1 << take))
+        point = _point_for_window(field, host, base, digit, take)
+        added = _add_fixed(curve, jacobian, accumulator, point)
+        enabled = digit if take == 1 else field.nonzero(digit)
+        accumulator = _choose(field, enabled, added, accumulator)
+        scalar = quotient
+        if continued:
+            for _ in range(take):
+                base = host.add_host(base, base)
+    return accumulator
+
+
+def require_affine_msm(field, constant, terms, claimed_x, claimed_y, *, checked_offset=None, window_bits=1):
     """Check a bounded fixed-base sum with an optional already authenticated G1 offset."""
+    if type(window_bits) is not int or window_bits not in (1, 2, 3):
+        raise ValueError("expected a fixed-base MSM window of 1, 2 or 3 bits")
     for point in (constant, *(base for _, base, _ in terms)):
