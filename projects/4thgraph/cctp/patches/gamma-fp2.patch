@@ -0,0 +1,55 @@
+"""Exercise the checked gamma-line rewrite at finite and infinite public-key sums."""
+
+from dataclasses import replace
+import os
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+from field import R
+from fixtures import fixture, G1, G2, transactions
+from forth_verifier import FORTH_SOURCE, Groth16Words, build_unlock, compile_verifier
+from public_inputs import verification_key_point
+from shared.chain_gang import validate_at_heights
+from verifier import Curve, Host, Proof, verify_host
+
+
+class GammaFp2Tests(unittest.TestCase):
+    def test_infinity_and_finite_paths(self):
+        original, _, _ = fixture()
+        g1, g2 = Curve(Host()), Curve(Host(), twist=True)
+        key = replace(original, ic=(G1, g1.negate(G1), G1))
+        checkout = Path(os.environ["FOURTHGRAPH_CHECKOUT"])
+        source = FORTH_SOURCE.read_text()
+        baseline = compile_verifier(checkout, key, source)[0]
+        candidate = compile_verifier(checkout, key, source.replace(
+            "bind-windowed-public-inputs swap", "bind-windowed-public-inputs-fp2 swap",
+        ))[0]
+        self.assertLess(len(candidate), len(baseline))
+        for signals in ((0, 0), (1, 0), (2, 0)):
+            with self.subTest(signals=signals):
+                # Generate test-only Groth16 equation vectors with known VK scalars.
+                k = 1 - signals[0] + signals[1]
+                self.assertEqual(verification_key_point(key.ic, signals), g1.mul_host(G1, k % R))
+                a, b = 11, 17
+                c = (a * b - 23 * 31 - 37 * k) * pow(41, -1, R) % R
+                proof = Proof(g1.mul_host(G1, a), g2.mul_host(G2, b), g1.mul_host(G1, c))
+                self.assertTrue(verify_host(key, signals, proof))
+                valid = build_unlock(key, signals, proof)
+                invalid = build_unlock(key, ((signals[0] + 1), signals[1]), proof)
+                for lock in (baseline, candidate):
+                    parent, spend = transactions(lock, valid, 2)
+                    context = dict(spend_height=4, activation_height=3, utxo_heights=(3,))
+                    validate_at_heights(spend, (parent,), **context)
+                    with self.assertRaisesRegex((ValueError, RuntimeError), "Error evaluating the script"):
+                        validate_at_heights(spend.with_script(0, invalid), (parent,), **context)
+
+    def test_zero_intercept_retains_identity_selection(self):
+        key, _, _ = fixture()
+        words = Groth16Words(key)
+        with patch("forth_verifier.prepared_lines", return_value=((((1, 0), (0, 0)),),)):
+            self.assertIsNotNone(words.bind_inputs_fp2(words.public_claim(), 2)[2])
+
+
+if __name__ == "__main__":
+    unittest.main()
